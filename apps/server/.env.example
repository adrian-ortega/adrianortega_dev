PORT=3000
APP_ORIGIN="http://localhost:5173"
APP_PUBLIC_DIR=
APP_DATA_DIR=
# Path to the content directory (mounted volume in production)
APP_CONTENT_DIR=

SENTRY_DSN=
ENABLE_CACHE=true

# Contact form — MySQL on 234 (schema: setup.sql at repo root)
DB_HOST=192.168.0.234
DB_PORT=3306
DB_NAME=adrianortegadev
DB_USER=aodev
DB_PASSWORD=
# Secret for HMAC-signed CSRF nonces. Random fallback is generated if unset,
# but set it in production so nonces survive restarts.
CONTACT_NONCE_SECRET=

# Contact form email notification (Resend). All three must be set or no
# email is sent (submissions are still saved). Use a sending-only key for
# this site; the sender must be on a Resend-verified domain.
RESEND_API_KEY=
CONTACT_NOTIFY_TO=
CONTACT_NOTIFY_FROM="adrianortega.dev <contact@ortegas.co>"
